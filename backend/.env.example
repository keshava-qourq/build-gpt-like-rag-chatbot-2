# Copy to .env and fill in for local development. Every variable has a
# working default in code (see app/database.py, app/storage.py, app/queue.py,
# app/auth.py, app/providers/) so the app starts with none of this set --
# these are what to override once real infrastructure exists.

# db: defaults to a local SQLite file. Point at Postgres 16 with the pgvector
# extension available (RDS in prod) to get a real vector column on `chunks`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# api: origins the browser is allowed to call this API from (comma separated).
ALLOWED_ORIGINS=http://localhost:5173

# api: JWT signing. Always override the default outside local development.
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=1440

# s3: AWS S3 in prod (leave S3_ENDPOINT_URL unset); MinIO locally.
S3_BUCKET=documents
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# queue: Redis locally; an SQS-backed broker URL in prod.
CELERY_BROKER_URL=redis://localhost:6379/0

# queue: how many documents one worker process ingests concurrently; the
# rest of a queued batch waits in the broker until a slot frees up.
CELERY_WORKER_CONCURRENCY=4

# llm / embeddings: provider is a registry lookup (app/providers/llm.py,
# app/providers/embeddings.py) keyed by *_PROVIDER; "openai" is the only
# entry registered today and is the default if unset.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
OPENAI_API_KEY=

# generation: how many of the most recent conversation turns a follow-up
# question's rewrite (e.g. "when does it expire?" -> a standalone query) is
# allowed to see -- never the full conversation history, however long it
# has grown (app/generation.py).
FOLLOWUP_CONTEXT_TURNS=6

# --- docker compose stack (backend/docker-compose.yml) -----------------
# Everything below is read either directly by the backend/worker
# containers (via `env_file: .env`) or by docker-compose.yml itself to
# configure the postgres/minio containers and the frontend build. Safe
# local defaults; override before anything but local development.

# postgres: credentials for the `postgres` service compose starts. Must
# match DATABASE_URL above (compose overrides DATABASE_URL's host to
# `postgres` automatically; only change these if you change these).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# minio: local S3-compatible object storage, no AWS dependency required to
# run the stack locally. Reused as MINIO_ROOT_USER/MINIO_ROOT_PASSWORD by
# the `minio` service and to create S3_BUCKET on first startup via the
# one-shot `minio-init` service -- keep these equal to
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above.

# frontend: baked into the static build at image-build time (Vite inlines
# VITE_* at build, not at container start), so the frontend talks to the
# backend container exposed on the host at this URL.
VITE_API_BASE_URL=http://localhost:8000

# auth: the one admin account created on first startup (backend/app/
# seed_admin.py, run before uvicorn by the `backend` service's compose
# command). Unset means no admin user is seeded and sign-in must happen
# through an invitation instead. A restart with these still set and an
# admin user already present is a no-op -- it is not re-created or
# updated.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-first-login
