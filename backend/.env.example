# Copy to .env and fill in for local development. Every variable has a
# working default in code (see app/database.py, app/storage.py, app/queue.py,
# app/auth.py, app/providers/) so the app starts with none of this set --
# these are what to override once real infrastructure exists.

# db: defaults to a local SQLite file. Point at Postgres 16 with the pgvector
# extension available (RDS in prod) to get a real vector column on `chunks`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# api: origins the browser is allowed to call this API from (comma separated).
ALLOWED_ORIGINS=http://localhost:5173

# api: JWT signing. Always override the default outside local development.
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=1440

# s3: AWS S3 in prod (leave S3_ENDPOINT_URL unset); MinIO locally.
S3_BUCKET=documents
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# queue: Redis locally; an SQS-backed broker URL in prod.
CELERY_BROKER_URL=redis://localhost:6379/0

# llm / embeddings: default OpenAI provider.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
